# Copy to .env (run_dev.py creates one automatically with random keys).
# All three services must share the same values.

# Signs and verifies user tokens (auth service + gateway).
SECRET_KEY=change-me
# Required on every gateway -> service call; services reject requests without it.
INTERNAL_API_KEY=change-me

# Where the gateway (and the document service) reach the other services.
AUTH_SERVICE_URL=http://127.0.0.1:8001
DOCUMENT_SERVICE_URL=http://127.0.0.1:8002

# Frontend origin(s) allowed to call the gateway, comma-separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Per-service SQLite files.
AUTH_DB_PATH=data/auth.db
DOCUMENTS_DB_PATH=data/documents.db

# Seed the reviewer accounts and the welcome document on first start.
SEED_DEMO_DATA=true
# In production, refuse to start without SECRET_KEY and INTERNAL_API_KEY.
APP_ENV=development
